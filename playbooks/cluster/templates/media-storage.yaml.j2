apiVersion: v1
kind: Namespace
metadata:
  name: media
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: media-data
spec:
  capacity:
    storage: 4Ti                     # hard drive size
  accessModes: [ReadWriteMany]
  persistentVolumeReclaimPolicy: Retain   # deleting the claim NEVER deletes the files
  storageClassName: nfs-static            # a label that ties this PV to its claim; no real class exists
  mountOptions: [nfsvers=4.2, hard, noatime]
  nfs:
    server: {{ nfs_server_ip }}
    path: {{ data_export_path }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: media-data
  namespace: media
spec:
  accessModes: [ReadWriteMany]
  storageClassName: nfs-static
  volumeName: media-data
  resources:
    requests:
      storage: 4Ti
---
# The 2TB SSD: staging drive
apiVersion: v1
kind: PersistentVolume
metadata:
  name: media-incomplete
spec:
  capacity:
    storage: 1800Gi
  accessModes: [ReadWriteMany]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: nfs-static
  mountOptions: [nfsvers=4.2, hard, noatime]
  nfs:
    server: {{ nfs_server_ip }}
    path: {{ staging_export_path }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: media-incomplete
  namespace: media
spec:
  accessModes: [ReadWriteMany]
  storageClassName: nfs-static
  volumeName: media-incomplete
  resources:
    requests:
      storage: 1800Gi
