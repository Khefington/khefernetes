# Managed by Ansible (khefernetes). The API key lives in the Secret 'jellyfin-api', created by `make jellyfin-provision`.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: jellyfin-backup
  namespace: {{ media_namespace }}
spec:
  schedule: "{{ jellyfin_backup_schedule }}"
  timeZone: {{ timezone }}
  concurrencyPolicy: Forbid           # never two backups at once
  startingDeadlineSeconds: 3600       # if the cluster was down at 03:15, still run within the hour
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 1800
      ttlSecondsAfterFinished: 604800   # tidy finished jobs after a week
      template:
        metadata:
          labels:
            app: jellyfin-backup
        spec:
          restartPolicy: Never
          securityContext:
            runAsNonRoot: true
            runAsUser: {{ media_uid }}
            runAsGroup: {{ media_gid }}
            seccompProfile:
              type: RuntimeDefault
          containers:
            - name: backup
              # Same pinned image as Jellyfin itself: already on the node and it ships curl.
              image: docker.io/jellyfin/jellyfin:{{ jellyfin_version }}
              command: ["/bin/sh", "-ec"]
              args:
                - |
                  echo "1/4 Asking Jellyfin to create a consistent backup (database only)..."
                  # Jellyfin writes the zip straight into the backup folder on the HDD (it is mounted into
                  # the Jellyfin pod), so we only need to notice which file is new.
                  ls -1 /dest/*.zip 2>/dev/null | sort > /tmp/before || true
                  curl -fsS --max-time 900 -X POST \
                    -H "Authorization: MediaBrowser Token=\"${JELLYFIN_API_KEY}\"" \
                    -H "Content-Type: application/json" \
                    -d '{"Database":true,"Metadata":false,"Trickplay":false,"Subtitles":false}' \
                    http://jellyfin.{{ media_namespace }}.svc.cluster.local:8096/Backup/Create
                  echo
                  echo "2/4 Checking the new backup file landed on the HDD..."
                  ls -1 /dest/*.zip 2>/dev/null | sort > /tmp/after || true
                  new=$(comm -13 /tmp/before /tmp/after)
                  [ -n "$new" ] || { echo "No new backup file appeared"; exit 1; }
                  for f in $new; do
                    [ -s "$f" ] || { echo "$f is empty"; exit 1; }
                    echo "  saved $(basename "$f") ($(stat -c %s "$f") bytes)"
                  done
                  echo "3/4 Saving the settings folders (small XML files and library definitions)..."
                  ts=$(date +%Y%m%d-%H%M%S)
                  dirs=""
                  for d in config root; do [ -d "/config/$d" ] && dirs="$dirs $d"; done
                  if [ -n "$dirs" ]; then
                    tar czf "/dest/jellyfin-settings-$ts.tgz.partial" -C /config $dirs
                    mv "/dest/jellyfin-settings-$ts.tgz.partial" "/dest/jellyfin-settings-$ts.tgz"
                    echo "  saved jellyfin-settings-$ts.tgz"
                  fi
                  echo "4/4 Keeping the newest {{ jellyfin_backup_keep }} of each kind..."
                  for pat in '*.zip' 'jellyfin-settings-*.tgz'; do
                    ls -1t /dest/$pat 2>/dev/null | tail -n +$(( {{ jellyfin_backup_keep }} + 1 )) | while read -r old; do echo "  removing $old"; rm -f "$old"; done
                  done
                  echo "Done."
              env:
                - name: JELLYFIN_API_KEY
                  valueFrom:
                    secretKeyRef:
                      name: jellyfin-api
                      key: api-key
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop: [ALL]
              resources:
                requests: {cpu: 50m, memory: 64Mi}
                limits: {memory: 256Mi}
              volumeMounts:
                - {name: config, mountPath: /config}      # Jellyfin's config volume (only backups/ and two small folders are touched)
                - name: backups
                  mountPath: /dest
                  subPath: backups/jellyfin                # on the HDD, outside the media library Jellyfin can see
          volumes:
            - name: config
              persistentVolumeClaim:
                claimName: jellyfin-config
            - name: backups
              persistentVolumeClaim:
                claimName: media-data
