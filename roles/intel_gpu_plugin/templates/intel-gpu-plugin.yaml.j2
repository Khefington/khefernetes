# Managed by Ansible (khefernetes). Edit the template, not the cluster.
# Based on the upstream manifest of release {{ intel_gpu_plugin_version }}
# (deployments/gpu_plugin/base/intel-gpu-plugin.yaml); changes: its own namespace, only on the GPU nodes,
# the GPU may be shared by {{ intel_gpu_plugin_shared_dev_num }} containers.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ intel_gpu_plugin_namespace }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: intel-gpu-plugin
  namespace: {{ intel_gpu_plugin_namespace }}
  labels:
    app: intel-gpu-plugin
spec:
  selector:
    matchLabels:
      app: intel-gpu-plugin
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 0
      maxUnavailable: 1
  template:
    metadata:
      labels:
        app: intel-gpu-plugin
    spec:
      automountServiceAccountToken: false
      containers:
        - name: intel-gpu-plugin
          image: docker.io/intel/intel-gpu-plugin:{{ intel_gpu_plugin_version }}
          imagePullPolicy: IfNotPresent
          args:
            - -shared-dev-num={{ intel_gpu_plugin_shared_dev_num }}
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: HOST_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.hostIP
          securityContext:
            seLinuxOptions:
              type: container_device_plugin_t
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            seccompProfile:
              type: RuntimeDefault
          resources:
            requests: {cpu: 40m, memory: 45Mi}
            limits: {cpu: 100m, memory: 90Mi}
          volumeMounts:
            - {name: devfs, mountPath: /dev/dri, readOnly: true}
            - {name: sysfsdrm, mountPath: /sys/class/drm, readOnly: true}
            - {name: kubeletsockets, mountPath: /var/lib/kubelet/device-plugins}
            - {name: cdipath, mountPath: /var/run/cdi}
      volumes:
        - name: devfs
          hostPath: {path: /dev/dri}
        - name: sysfsdrm
          hostPath: {path: /sys/class/drm}
        - name: kubeletsockets
          hostPath: {path: /var/lib/kubelet/device-plugins}
        - name: cdipath
          hostPath: {path: /var/run/cdi, type: DirectoryOrCreate}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: kubernetes.io/hostname
                    operator: In
                    values: {{ intel_gpu_plugin_nodes | to_json }}
