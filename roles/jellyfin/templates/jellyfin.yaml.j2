# Managed by Ansible (khefernetes). Edit the template, not the cluster.
# Jellyfin's config database (SQLite) lives on a node-local volume, NOT on NFS.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: jellyfin-config
  namespace: {{ media_namespace }}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path
  resources:
    requests:
      storage: {{ jellyfin_config_size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: jellyfin
  namespace: {{ media_namespace }}
  labels:
    app: jellyfin
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: jellyfin
  template:
    metadata:
      labels:
        app: jellyfin
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ media_uid }}      # the 'media' user, same owner as every file in the library
        runAsGroup: {{ media_gid }}
        fsGroup: {{ media_gid }}
        seccompProfile:
          type: RuntimeDefault
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: DoesNotExist     # keep it on the workers
      containers:
        - name: jellyfin
          image: docker.io/jellyfin/jellyfin:{{ jellyfin_version }}
          ports:
            - name: http
              containerPort: 8096
          env:
            - name: TZ
              value: {{ timezone }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: {{ jellyfin_cpu_request }}
              memory: {{ jellyfin_memory_request }}
            limits:
              memory: {{ jellyfin_memory_limit }}
          startupProbe:
            httpGet: {path: /health, port: http}
            periodSeconds: 5
            failureThreshold: 60     # allows up to 5 minutes for the first start
          readinessProbe:
            httpGet: {path: /health, port: http}
            periodSeconds: 10
          livenessProbe:
            httpGet: {path: /health, port: http}
            periodSeconds: 20
            failureThreshold: 3
          volumeMounts:
            - {name: config, mountPath: /config}
            - {name: cache, mountPath: /cache}
            # Jellyfin builds ffmpeg frames and trickplay tiles in /tmp/jellyfin, then moves the
            # finished tiles into /config/data/trickplay. A dedicated, sized, always-writable /tmp
            # keeps that independent of the container image's filesystem.
            - {name: tmp, mountPath: /tmp}
            - name: data
              mountPath: /media
              subPath: media
              readOnly: true         # Jellyfin can never modify or delete the library
            # Trickplay is stored on the 2TB SSD (NFS), not in /config, so a rebuilt cluster keeps it.
            # (Jellyfin's SQLite database stays on the node-local volume; only these image files are on NFS.)
            - name: appdata
              mountPath: /config/data/trickplay
              subPath: {{ jellyfin_trickplay_subpath }}
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: jellyfin-config
        - name: cache
          emptyDir:
            sizeLimit: {{ jellyfin_cache_limit }}   # transcoding scratch space
        - name: tmp
          emptyDir:
            sizeLimit: {{ jellyfin_tmp_limit }}
        - name: data
          persistentVolumeClaim:
            claimName: media-data
        - name: appdata
          persistentVolumeClaim:
            claimName: media-appdata
---
apiVersion: v1
kind: Service
metadata:
  name: jellyfin
  namespace: {{ media_namespace }}
spec:
  selector:
    app: jellyfin
  ports:
    - name: http
      port: 8096
      targetPort: http
---
# A standard Ingress with no controller-specific annotations
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: jellyfin
  namespace: {{ media_namespace }}
spec:
  ingressClassName: {{ jellyfin_ingress_class }}
  rules:
    - host: {{ jellyfin_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: jellyfin
                port:
                  name: http
    - http:                        # no host: also reachable by plain IP while there is no DNS name
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: jellyfin
                port:
                  name: http
