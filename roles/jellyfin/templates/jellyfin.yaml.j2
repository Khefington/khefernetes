# Managed by Ansible (khefernetes). Edit the template, not the cluster.
# Jellyfin's config database (SQLite) lives on a node-local volume, NOT on NFS.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: jellyfin-config
  namespace: {{ media_namespace }}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path
  resources:
    requests:
      storage: {{ jellyfin_config_size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: jellyfin
  namespace: {{ media_namespace }}
  labels:
    app: jellyfin
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: jellyfin
  template:
    metadata:
      labels:
        app: jellyfin
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ media_uid }}      # the 'media' user, same owner as every file in the library
        runAsGroup: {{ media_gid }}
        fsGroup: {{ media_gid }}
{% if jellyfin_gpu_enabled | bool %}
        supplementalGroups: [{{ gpu_render_gid }}]   # the 'render' group of the VM: /dev/dri/renderD128 belongs to it
{% endif %}
        seccompProfile:
          type: RuntimeDefault
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: DoesNotExist     # keep it on the workers
      initContainers:
        # Why this exists: /config/data/trickplay is a mount INSIDE the /config volume. When the
        # container starts, the runtime creates the missing parent folder /config/data itself, as
        # root. Jellyfin (running as the media user) then cannot write its marker file there and
        # crashes with "Access to the path '/config/data/.jellyfin-data' is denied".
        # This step runs first, makes the folder and hands it to the media user. It only touches the
        # config volume (not the NFS mounts), is safe to repeat, and also repairs an existing volume.
        - name: fix-config-ownership
          image: docker.io/jellyfin/jellyfin:{{ jellyfin_version }}
          command: ["sh", "-c", "mkdir -p /config/data && chown {{ media_uid }}:{{ media_gid }} /config /config/data"]
          securityContext:
            runAsUser: 0
            runAsNonRoot: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
              add: [CHOWN, DAC_OVERRIDE]   # only what mkdir/chown need
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {memory: 64Mi}
          volumeMounts:
            - {name: config, mountPath: /config}
      containers:
        - name: jellyfin
          image: docker.io/jellyfin/jellyfin:{{ jellyfin_version }}
          ports:
            - name: http
              containerPort: 8096
          env:
            - name: TZ
              value: {{ timezone }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: {{ jellyfin_cpu_request }}
              memory: {{ jellyfin_memory_request }}
            limits:
              memory: {{ jellyfin_memory_limit }}
{% if jellyfin_gpu_enabled | bool %}
              gpu.intel.com/i915: 1      # one share of the Intel GPU, handed out by the device plugin (roles/intel_gpu_plugin)
{% endif %}
          startupProbe:
            httpGet: {path: /health, port: http}
            periodSeconds: 5
            failureThreshold: 60     # allows up to 5 minutes for the first start
          readinessProbe:
            httpGet: {path: /health, port: http}
            periodSeconds: 10
          livenessProbe:
            httpGet: {path: /health, port: http}
            periodSeconds: 20
            failureThreshold: 3
          volumeMounts:
            - {name: config, mountPath: /config}
            - {name: cache, mountPath: /cache}
            # Jellyfin builds ffmpeg frames and trickplay tiles in /tmp/jellyfin, then moves the
            # finished tiles into /config/data/trickplay. A dedicated, sized, always-writable /tmp
            # keeps that independent of the container image's filesystem.
            - {name: tmp, mountPath: /tmp}
            - name: data
              mountPath: /media
              subPath: media
              readOnly: true         # Jellyfin can never modify or delete the library
            # Expensive-to-regenerate files (trickplay, ...) live on the 2TB SSD (NFS), not in /config, so a
            # rebuilt cluster keeps them. Jellyfin's SQLite database stays on the node-local volume.
{% for d in jellyfin_persisted_dirs %}
            - name: appdata
              mountPath: {{ d.mount }}
              subPath: {{ d.subpath }}
{% endfor %}
            # Jellyfin's own Dashboard > Backups page reads and writes /config/data/backups. Pointing it at the
            # backup folder on the HDD means: backups made in the UI land safely off the node, the nightly job's
            # files show up in the UI with a Restore button, and a rebuilt cluster finds them straight away.
            # Only this one folder is exposed (not the library, not the etcd snapshots next to it).
            - name: data
              mountPath: /config/data/backups
              subPath: backups/jellyfin
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: jellyfin-config
        - name: cache
          emptyDir:
            sizeLimit: {{ jellyfin_cache_limit }}   # transcoding scratch space
        - name: tmp
          emptyDir:
            sizeLimit: {{ jellyfin_tmp_limit }}
        - name: data
          persistentVolumeClaim:
            claimName: media-data
        - name: appdata
          persistentVolumeClaim:
            claimName: media-appdata
---
apiVersion: v1
kind: Service
metadata:
  name: jellyfin
  namespace: {{ media_namespace }}
spec:
  selector:
    app: jellyfin
  ports:
    - name: http
      port: 8096
      targetPort: http
---
# A standard Ingress with no controller-specific annotations
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: jellyfin
  namespace: {{ media_namespace }}
spec:
  ingressClassName: {{ jellyfin_ingress_class }}
  rules:
    - host: {{ jellyfin_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: jellyfin
                port:
                  name: http
    - http:                        # no host: also reachable by plain IP while there is no DNS name
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: jellyfin
                port:
                  name: http
